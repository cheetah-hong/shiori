  "fixed_sql": [
    {
      "name": "words",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"words\" (\"id\" TEXT NOT NULL, \"key\" TEXT NOT NULL UNIQUE, \"headword\" TEXT NOT NULL, \"readings\" TEXT NOT NULL, \"pos\" TEXT NULL, \"meaning\" TEXT NOT NULL, \"example_ja\" TEXT NULL, \"example_ko\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"hidden_at\" INTEGER NULL, PRIMARY KEY (\"id\"), CHECK ((example_ja IS NULL) = (example_ko IS NULL)));"
        }
      ]
    },
    {
      "name": "playlists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playlists\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(trim(name)) > 0));"
        }
      ]
    },
    {
      "name": "playlist_words",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playlist_words\" (\"playlist_id\" TEXT NOT NULL REFERENCES playlists (id) ON DELETE CASCADE, \"word_id\" TEXT NOT NULL REFERENCES words (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"added_at\" INTEGER NOT NULL, PRIMARY KEY (\"playlist_id\", \"word_id\"));"
        }
      ]
    },
    {
      "name": "review_cards",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"review_cards\" (\"scope\" TEXT NOT NULL, \"word_id\" TEXT NOT NULL REFERENCES words (id) ON DELETE CASCADE, \"level\" INTEGER NOT NULL, \"due_at\" INTEGER NOT NULL, \"last_reviewed_at\" INTEGER NOT NULL, \"review_count\" INTEGER NOT NULL, \"lapse_count\" INTEGER NOT NULL, PRIMARY KEY (\"scope\", \"word_id\"));"
        }
      ]
    },
    {
      "name": "review_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"review_logs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"scope\" TEXT NOT NULL, \"word_id\" TEXT NOT NULL, \"answer\" TEXT NOT NULL, \"at\" INTEGER NOT NULL, \"level_before\" INTEGER NOT NULL, \"level_after\" INTEGER NOT NULL, \"retries_in_session\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "playlist_words_by_word",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX playlist_words_by_word ON playlist_words (word_id)"
        }
      ]
    },
    {
      "name": "review_logs_by_time",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX review_logs_by_time ON review_logs (at)"
        }
      ]
    }
