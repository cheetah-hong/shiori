  "fixed_sql": [
    {
      "name": "textbooks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"textbooks\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"template_id\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "textbook_days",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"textbook_days\" (\"textbook_id\" TEXT NOT NULL REFERENCES textbooks (id), \"number\" INTEGER NOT NULL, \"title\" TEXT NOT NULL, PRIMARY KEY (\"textbook_id\", \"number\"));"
        }
      ]
    },
    {
      "name": "words",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"words\" (\"id\" TEXT NOT NULL, \"textbook_id\" TEXT NOT NULL REFERENCES textbooks (id), \"day\" INTEGER NULL, \"no\" TEXT NULL, \"headword\" TEXT NOT NULL, \"readings\" TEXT NOT NULL, \"pos\" TEXT NULL, \"meaning\" TEXT NOT NULL, \"example_ja\" TEXT NULL, \"example_ko\" TEXT NULL, \"page\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"hidden_at\" INTEGER NULL, PRIMARY KEY (\"id\"), CHECK ((example_ja IS NULL) = (example_ko IS NULL)));"
        }
      ]
    },
    {
      "name": "review_cards",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"review_cards\" (\"word_id\" TEXT NOT NULL, \"level\" INTEGER NOT NULL, \"due_at\" INTEGER NOT NULL, \"last_reviewed_at\" INTEGER NOT NULL, \"review_count\" INTEGER NOT NULL, \"lapse_count\" INTEGER NOT NULL, PRIMARY KEY (\"word_id\"));"
        }
      ]
    },
    {
      "name": "review_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"review_logs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"word_id\" TEXT NOT NULL, \"answer\" TEXT NOT NULL, \"at\" INTEGER NOT NULL, \"level_before\" INTEGER NOT NULL, \"level_after\" INTEGER NOT NULL, \"retries_in_session\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "words_by_place",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX words_by_place ON words (textbook_id, day, \"no\")"
        }
      ]
    },
    {
      "name": "review_logs_by_time",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX review_logs_by_time ON review_logs (at)"
        }
      ]
